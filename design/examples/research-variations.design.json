        "body": {
          "kind": "bounded_loop",
          "loop_id": "research-loop",
          "limits": {
            "max_iterations": 20,
            "max_wall_sec": 14400,
            "max_consecutive_crashes": 3
          },
          "termination": [
            "budget_exhausted",
            "manual_pause_or_cancel",
            "protocol_invalidation"
          ],
          "body": {
            "kind": "sequence",
            "movements": [
              {
                "movement_id": "propose",
                "chairs": [
                  "protocol.oboe"
                ],
                "inputs": [
                  "baseline.json",
                  "experiment-ledger"
                ],
                "outputs": [
                  "hypothesis.json"
                ],
                "exit_gate": "hypothesis_scoped"
              },
              {
                "movement_id": "patch",
                "chairs": [
                  "research.impl"
                ],
                "inputs": [
                  "hypothesis.json"
                ],
                "outputs": [
                  "candidate.patch"
                ],
                "exit_gate": "candidate_preflight_passed"
              },
              {
                "movement_id": "experiment",
                "chairs": [
                  "experiment.snare"
                ],
                "inputs": [
                  "candidate.patch",
                  "protocol.json"
                ],
                "outputs": [
                  "trial.json",
                  "trial.log"
                ],
                "exit_gate": "trial_outcome_recorded"
              },
              {
                "movement_id": "judge",
                "chairs": [
                  "judge.violin2"
                ],
                "inputs": [
                  "trial.json",
                  "baseline.json"
                ],
                "outputs": [
                  "decision.json"
                ],
                "exit_gate": "outcome_classified"
              },
              {
                "movement_id": "checkpoint",
                "chairs": [
                  "control.conductor"
                ],
                "inputs": [
                  "decision.json"
                ],
                "outputs": [
                  "experiment-checkpoint"
                ],
                "exit_gate": "keep_or_discard_recorded"
              }
            ]
          },
          "decision_outcomes": [
            "keep",
            "discard",
            "crash"
          ],
          "retry_policy_ref": "separate-attempt-policy",
          "checkpoint_fields": [
            "iteration_id",
            "plan_revision",
            "baseline_commit",
            "candidate_commit",
            "metric_artifact",
            "decision",
            "next_iteration"
          ],
          "decision_policy": "Valid trials compare under the frozen protocol; crash/timeout/missing metrics skip ranking and enter the declared retry/recording policy.",
          "inputs": [
            "baseline.json",
            "protocol.json"
          ],
          "outputs": [
            "best-valid-candidate",
            "experiment-ledger"
          ],
          "initial_state": {
            "best-valid-candidate": "baseline.json",
            "experiment-ledger": []
          }
        }
      },
      {
        "chapter_id": "validation",
        "form": "mozart_sonata",
        "depends_on": [
          "variations"
        ],
        "body": {
          "kind": "sequence",
          "movements": [
            {
              "movement_id": "reproduce",
              "chairs": [
                "experiment.snare"
              ],
              "inputs": [
                "best-valid-candidate",
                "protocol.json"
              ],
              "outputs": [
                "reproduction.json"
              ],
              "exit_gate": "independent_validation_passed"
            }
          ]
        }
      }
    ]
