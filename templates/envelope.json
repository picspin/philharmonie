{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MadaSymphonyMessage",
  "description": "Standard Envelope for Mada Symphony A2A and ANP communication. Isolation fields drive spawn; they are not costume.",
  "type": "object",
  "required": ["protocol", "message_type", "movement", "sender", "cue", "ground_bass_ref", "payload"],
  "properties": {
    "protocol": {
      "type": "string",
      "enum": ["Mada-A2A/1.0", "Mada-ANP/1.0"]
    },
    "message_type": {
      "type": "string",
      "enum": ["EVENT_BROADCAST", "POINT_TO_POINT_HANDOVER", "COUNTERPOINT_CHALLENGE", "STRETTO_ARBITRATION", "TACET_DIRECTIVE"]
    },
    "movement": {
      "type": "string",
      "description": "Current movement name, e.g., 'I. Overture', 'II. Variation', 'III. Counterpoint'"
    },
    "sender": {
      "type": "object",
      "required": ["section", "agent_id", "model"],
      "properties": {
        "section": {
          "type": "string",
          "enum": ["conductor", "oboe", "violin_1", "violin_2", "viola", "cello", "contrabass", "horn", "flute", "organ", "heavy_brass", "snare_drum", "cymbals", "harp", "bassoon", "trumpet"]
        },
        "agent_id": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "recipient": {
      "type": "object",
      "properties": {
        "section": { "type": "string" },
        "agent_id": { "type": "string" }
      }
    },
    "cue": {
      "type": "string",
      "description": "Event or motive triggering this communication (e.g., SPEC_LOCKED, PATCH_READY, TEST_FAILED)"
    },
    "ground_bass_ref": {
      "type": "string",
      "description": "Reference to immutable spec/contract, e.g., 'SPEC.md#v1.0' or commit hash"
    },
    "sidechain": {
      "type": "boolean",
      "default": false,
      "description": "True → isolated conversation (delegate_task or hermes chat -w). Does not by itself create a git worktree."
    },
    "isolation": {
      "type": "string",
      "enum": ["worktree", "shared"],
      "default": "shared",
      "description": "worktree = hermes chat -w (Subject/Horn writers). shared = Violin II / Snare on the sounding tree. delegate_task isolates context only."
    },
    "allowed_toolsets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Heteronomous Tacet: spawn with -t matching this list. Empty = no tools. A Tacet chair must not receive file write or terminal."
    },
    "tacet_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ground-bass paths this chair must not write (SPEC.md, contracts, locked tests)."
    },
    "budget": {
      "type": "object",
      "properties": {
        "dynamic_mark": { "type": "string", "enum": ["ppp", "pp", "p", "mp", "mf", "f", "ff", "ffff"] },
        "max_tokens": { "type": "integer" },
        "timeout_sec": { "type": "integer" }
      }
    },
    "payload": {
      "type": "object",
      "description": "Concrete deliverable or event payload",
      "properties": {
        "summary": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "path_or_uri"],
            "properties": {
              "type": { "type": "string", "enum": ["spec", "patch", "test_report", "ast_diff", "metric"] },
              "path_or_uri": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        },
        "adversarial_points": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
